PORT=8787
PLAY_JWT_SECRET=change-me-shared-with-web
# On-site NVR (UNVR Pro), not the UDM gateway
PROTECT_HOST=192.168.50.152
PROTECT_USER=
PROTECT_PASS=
# Protect Integration API key (preferred)
PROTECT_API_KEY=
# actionId -> trigger
# kinds: webhook | alarmWebhook | testSound | talkback | automation | ringtone | sequence
# talkback: streams a local file from AUDIO_DIR (supports loop + stop)
# sequence: ordered steps — talkback | wait | ringtone | testSound
# ACTIONS={"bells.second":{"kind":"sequence","steps":[{"kind":"talkback","file":"Bell_1.mp3","speakerIds":["..."]},{"kind":"wait","ms":8000},{"kind":"talkback","file":"Bell_1.mp3","speakerIds":["..."]}]}}
ACTIONS={}
AUDIO_DIR=
# Local Protect admin (NOT SSH root) — required for talkback streaming
# Cloud remote play (Ably push + slow D1 fallback poll)
# GATEWAY_POLL_SECRET=   # same as Worker secret
# CLOUD_POLL_URL=https://alarm.arnoldcoc.org/api/gateway/poll
# CLOUD_POLL_MS=60000    # fallback poll only (default 60s)
# CLOUD_TELEMETRY_MS=30000
# CLOUD_ABLY_TOKEN_URL=https://alarm.arnoldcoc.org/api/gateway/ably-token
# CLOUD_ABLY_PUSH=1      # set 0 to disable Ably push
CORS_ORIGIN=https://alarm.arnoldcoc.org

# Convenience PA (SIP dial-in → live talkback) — NOT for emergency
# PA_ENABLED=1
# PA_PREAMBLE_FILE=off   # off = mic live immediately; or a short clip before page
# PA_EXT=9090
# PA_TEST_EXT=9099
# UniFi Talk Third-Party Device (Pi registers TO Talk — dial the Talk extension)
# PA_TALK_HOST=192.168.1.1
# PA_TALK_PORT=5060
# PA_TALK_USER=
# PA_TALK_PASS=
# PA_TALK_MODE=menu
# PA_SIP_PORT=5060
# PA_SPEAKER_IDS=6a3eee6d0024b103e44959f2,6a3b38450023b103e433fcab,6a3b3da90010b103e4341d80,6a3b06950026b103e4329ce6
# TALK_CONSOLE_IP=192.168.1.1
# Before speaker check, ring these Talk desk extensions with a stand-by prompt
# TEST_NOTIFY_EXTS=0023,0011,0014,0015
# TEST_NOTIFY_LABELS=0023:Adin's phone,0011:Left desk,0014:Elders office,0015:Right desk
# Endpoint App only (skip for now): 0013,0018,0019,0020
# TEST_NOTIFY_RING_MS=25000
# TEST_NOTIFY_DTMF_MS=12000
# TEST_NOTIFY_DELAY_MINUTES=5
# TEST_NOTIFY_SETTLE_MS=1500
# Pause after answer before prompt (Talk media bridge). Default caller: PA_TALK_USER (9090 Campus Security).
# TEST_NOTIFY_FROM=9090
# PA_MAX_CONCURRENT_CALLS=8
# Prompt clips (8 kHz mono s16le) — render on a Mac: bash scripts/render-notify-pcm.sh all
# TEST_NOTIFY_PROMPT=~/.config/arnold-alarm/audio/pa-sip-test-notify.pcm
# TEST_NOTIFY_DELAY_PROMPT=~/.config/arnold-alarm/audio/pa-sip-test-delay.pcm
# Set while auditioning the desk prompt — rings TEST_NOTIFY_EXTS only, no campus horns
# SPEAKER_CHECK_NOTIFY_ONLY=1
