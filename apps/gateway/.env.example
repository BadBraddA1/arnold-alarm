PORT=8787
PLAY_JWT_SECRET=change-me-shared-with-web
# UniFi Protect / console
PROTECT_HOST=192.168.1.1
PROTECT_USER=local_admin
PROTECT_PASS=
# Optional Integration API key (preferred when set)
PROTECT_API_KEY=
# JSON map: actionId -> { "kind": "webhook", "url": "..." } | { "kind": "automation", "id": "uuid" }
# Example:
# ACTIONS={"bells.period_start":{"kind":"webhook","url":"https://192.168.1.1/proxy/protect/api/..."},"evacuate.main":{"kind":"automation","id":"..."}}
ACTIONS={}
# CORS: allow the Vercel origin so the browser can call the LAN gateway
CORS_ORIGIN=https://alarm.arnoldcoc.org
