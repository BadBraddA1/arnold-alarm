PORT=8787
PLAY_JWT_SECRET=change-me-shared-with-web
# On-site NVR (UNVR Pro), not the UDM gateway
PROTECT_HOST=192.168.50.152
PROTECT_USER=
PROTECT_PASS=
# Protect Integration API key (preferred)
PROTECT_API_KEY=
# actionId -> trigger
# kinds: webhook | alarmWebhook | testSound | talkback | automation | ringtone
# talkback: streams a local .ogg from AUDIO_DIR (supports loop + stop)
# ACTIONS={"evacuate.code_blue":{"kind":"talkback","file":"Code_Blue_Master.ogg","speakerIds":["..."]}}
ACTIONS={}
AUDIO_DIR=
# Local Protect admin (NOT SSH root) — required for talkback streaming
CORS_ORIGIN=https://alarm.arnoldcoc.org

# Convenience PA (SIP dial-in → live talkback) — NOT for emergency
# PA_ENABLED=1
# PA_EXT=1010
# PA_SIP_PORT=5060
# PA_SPEAKER_IDS=6a3eee6d0024b103e44959f2,6a3b38450023b103e433fcab,6a3b3da90010b103e4341d80,6a3b06950026b103e4329ce6
